Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_version = "202502.21.0"

  # Define the Server VM (K3s Controller)
  config.vm.define "werrahmaS" do |server|
    server.vm.hostname = "werrahmaS"
    server.vm.network "private_network", ip: "192.168.56.110"
    
    server.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      v.customize ["modifyvm", :id, "--name", "werrahmaS"]
    end

    # Copy provisioning scripts
    server.vm.provision "file", source: "scripts/install_k3s_server.sh", destination: "/tmp/install_k3s_server.sh"
    server.vm.provision "shell", inline: "chmod +x /tmp/install_k3s_server.sh"
    
    # Run K3s server installation
    server.vm.provision "shell", path: "scripts/install_k3s_server.sh"
  end

  # Define the Worker VM (K3s Agent)
  config.vm.define "werrahmaSW" do |worker|
    worker.vm.hostname = "werrahmaSW"
    worker.vm.network "private_network", ip: "192.168.56.111"
    
    worker.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      v.customize ["modifyvm", :id, "--name", "werrahmaSW"]
    end

    # Copy provisioning scripts
    worker.vm.provision "file", source: "scripts/install_k3s_agent.sh", destination: "/tmp/install_k3s_agent.sh"
    worker.vm.provision "shell", inline: "chmod +x /tmp/install_k3s_agent.sh"
    
    # Run K3s agent installation (depends on server being ready)
    worker.vm.provision "shell", path: "scripts/install_k3s_agent.sh"
  end
end

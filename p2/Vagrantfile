Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_version = "202502.21.0"

  # Define the K3s Server VM (single machine for Part 2)
  config.vm.define "werrahmaS" do |server|
    server.vm.hostname = "werrahmaS"
    server.vm.network "private_network", ip: "192.168.56.110"
    
    server.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      v.customize ["modifyvm", :id, "--name", "werrahmaS"]
    end

    # SSH configuration
    server.vm.provision "shell", inline: <<-SHELL
      mkdir -p /root/.ssh
      chmod 700 /root/.ssh
    SHELL

    # Copy provisioning scripts
    server.vm.provision "file", source: "scripts/install_k3s.sh", destination: "/tmp/install_k3s.sh"
    server.vm.provision "shell", inline: "chmod +x /tmp/install_k3s.sh"
    
    # Copy configuration files
    server.vm.provision "file", source: "confs/", destination: "/tmp/confs"

    # Run K3s server installation (script applies manifests from /tmp/confs)
    server.vm.provision "shell", path: "scripts/install_k3s.sh"
  end
end
